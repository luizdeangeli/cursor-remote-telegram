# Token do @BotFather. Não compartilhe este arquivo.
TELEGRAM_BOT_TOKEN=

# Id numérico do seu usuário. Vazio exige /parear com o código do terminal.
TELEGRAM_ALLOWED_USER_ID=

# Id do grupo (negativo). Vazio exige /parear com o código do terminal.
TELEGRAM_CHAT_ID=

CDP_URL=http://127.0.0.1:9222
POLL_INTERVAL_MS=2000

# todas cria um tópico para cada conversa visível.
# escolhidas só cria o tópico depois de Incluir, pelo menu Projetos.
COMPARTILHAR=todas
